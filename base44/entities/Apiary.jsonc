{
  "type": "object",
  "name": "Apiary",
  "properties": {
    "code": {
      "type": "string",
      "description": "C\u00f3digo del apiario, por ejemplo APN-01"
    },
    "name": {
      "type": "string",
      "description": "Nombre del apiario"
    },
    "location": {
      "type": "string",
      "description": "Paraje, sector o referencia de ubicaci\u00f3n"
    },
    "owner": {
      "type": "string",
      "description": "Responsable del apiario"
    },
    "status": {
      "type": "string",
      "enum": [
        "activo",
        "en_revision",
        "inactivo"
      ],
      "enumColors": [
        "green",
        "yellow",
        "gray"
      ],
      "default": "activo"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "code",
    "name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}