{
  "type": "object",
  "name": "BreedingLine",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nombre de la l\u00ednea"
    },
    "code": {
      "type": "string",
      "description": "C\u00f3digo corto, por ejemplo L-04"
    },
    "origin": {
      "type": "string",
      "description": "Origen y a\u00f1o de selecci\u00f3n"
    },
    "gentleness": {
      "type": "number",
      "description": "Docilidad de 1 a 5"
    },
    "productivity": {
      "type": "number",
      "description": "Producci\u00f3n de miel de 1 a 5"
    },
    "hygienic": {
      "type": "number",
      "description": "Comportamiento higi\u00e9nico de 1 a 5"
    },
    "varroa": {
      "type": "number",
      "description": "Resistencia a varroa de 1 a 5"
    },
    "honeyAvg": {
      "type": "number",
      "description": "Producci\u00f3n media de miel por colmena (kg)"
    },
    "notes": {
      "type": "string"
    },
    "active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}