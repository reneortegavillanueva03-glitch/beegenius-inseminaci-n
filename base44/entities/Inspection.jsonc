{
  "type": "object",
  "name": "Inspection",
  "properties": {
    "date": {
      "type": "string",
      "format": "date",
      "description": "Fecha de la inspecci\u00f3n"
    },
    "apiary": {
      "type": "string",
      "description": "Apiario inspeccionado"
    },
    "hiveCode": {
      "type": "string",
      "description": "Colmena o n\u00facleo inspeccionado"
    },
    "queenCode": {
      "type": "string",
      "description": "Reina observada"
    },
    "type": {
      "type": "string",
      "enum": [
        "rutina",
        "postura",
        "sanidad",
        "alimentacion",
        "otro"
      ],
      "enumColors": [
        "blue",
        "green",
        "red",
        "yellow",
        "gray"
      ],
      "default": "rutina"
    },
    "colony": {
      "type": "string",
      "enum": [
        "fuerte",
        "media",
        "debil"
      ],
      "enumColors": [
        "green",
        "yellow",
        "red"
      ],
      "default": "media"
    },
    "queenSeen": {
      "type": "boolean",
      "description": "Se observ\u00f3 la reina durante la inspecci\u00f3n"
    },
    "laying": {
      "type": "string",
      "enum": [
        "sin_postura",
        "postura_inicial",
        "postura_consolidada"
      ],
      "enumColors": [
        "gray",
        "yellow",
        "green"
      ],
      "default": "sin_postura"
    },
    "varroa": {
      "type": "number",
      "description": "\u00c1caros de varroa por 100 abejas"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "date"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}